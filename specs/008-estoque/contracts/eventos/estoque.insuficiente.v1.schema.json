{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LucasFrenhan/Order-Management-System/specs/008-estoque/contracts/eventos/estoque.insuficiente.v1.schema.json",
  "title": "estoque.insuficiente v1",
  "description": "Publicado pelo worker de estoque (REQ-08) quando algum item do pedido não tinha estoque ou estava inativo; o pedido foi cancelado e nenhum estoque foi alterado.",
  "type": "object",
  "required": ["idEvento", "tipo", "versao", "ocorridoEm", "idCorrelacao", "dados"],
  "properties": {
    "idEvento": { "type": "string", "format": "uuid" },
    "tipo": { "const": "estoque.insuficiente" },
    "versao": { "const": 1 },
    "ocorridoEm": { "type": "string", "format": "date-time" },
    "idCorrelacao": { "type": "string", "format": "uuid" },
    "dados": {
      "type": "object",
      "required": ["pedidoId", "itens"],
      "properties": {
        "pedidoId": { "type": "string", "format": "uuid" },
        "itens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["produtoId", "quantidadeSolicitada", "quantidadeDisponivel", "inativo"],
            "properties": {
              "produtoId": { "type": "string", "format": "uuid" },
              "quantidadeSolicitada": { "type": "integer", "minimum": 1 },
              "quantidadeDisponivel": { "type": "integer", "minimum": 0 },
              "inativo": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
