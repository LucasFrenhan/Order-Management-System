{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LucasFrenhan/Order-Management-System/specs/006-mensageria/contracts/eventos/estoque.reservado.v1.schema.json",
  "title": "estoque.reservado v1",
  "description": "Publicado pelo worker de estoque (issue #8) quando todos os itens do pedido foram reservados.",
  "type": "object",
  "required": ["idEvento", "tipo", "versao", "ocorridoEm", "idCorrelacao", "dados"],
  "properties": {
    "idEvento": { "type": "string", "format": "uuid" },
    "tipo": { "const": "estoque.reservado" },
    "versao": { "const": 1 },
    "ocorridoEm": { "type": "string", "format": "date-time" },
    "idCorrelacao": { "type": "string", "format": "uuid" },
    "dados": {
      "type": "object",
      "required": ["pedidoId", "itens"],
      "properties": {
        "pedidoId": { "type": "string", "format": "uuid" },
        "itens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["produtoId", "quantidade"],
            "properties": {
              "produtoId": { "type": "string", "format": "uuid" },
              "quantidade": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
