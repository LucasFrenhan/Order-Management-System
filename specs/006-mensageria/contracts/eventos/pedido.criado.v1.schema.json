{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LucasFrenhan/Order-Management-System/specs/006-mensageria/contracts/eventos/pedido.criado.v1.schema.json",
  "title": "pedido.criado v1",
  "description": "Publicado quando um pedido é criado (REQ-05/REQ-06). Entrega pelo menos uma vez: deduplicar por idEvento.",
  "type": "object",
  "required": ["idEvento", "tipo", "versao", "ocorridoEm", "idCorrelacao", "dados"],
  "properties": {
    "idEvento": { "type": "string", "format": "uuid" },
    "tipo": { "const": "pedido.criado" },
    "versao": { "const": 1 },
    "ocorridoEm": { "type": "string", "format": "date-time" },
    "idCorrelacao": { "type": "string", "format": "uuid", "description": "Identificador do pedido." },
    "dados": {
      "type": "object",
      "required": ["pedidoId", "numero", "clienteId", "itens", "valorTotal", "moeda"],
      "properties": {
        "pedidoId": { "type": "string", "format": "uuid" },
        "numero": { "type": "string", "pattern": "^PED-\\d{8}-\\d{6}$" },
        "clienteId": { "type": "string", "format": "uuid" },
        "itens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["produtoId", "quantidade", "precoUnitario"],
            "properties": {
              "produtoId": { "type": "string", "format": "uuid" },
              "quantidade": { "type": "integer", "minimum": 1 },
              "precoUnitario": { "type": "number", "minimum": 0, "multipleOf": 0.01 }
            },
            "additionalProperties": false
          }
        },
        "valorTotal": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
        "moeda": { "const": "BRL" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
