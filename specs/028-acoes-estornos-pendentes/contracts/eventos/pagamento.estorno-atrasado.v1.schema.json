{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LucasFrenhan/Order-Management-System/specs/028-acoes-estornos-pendentes/contracts/eventos/pagamento.estorno-atrasado.v1.schema.json",
  "title": "pagamento.estorno-atrasado v1",
  "description": "Publicado pelo processo de workers, uma única vez por estorno, na mesma gravação da falha que leva o estorno além do limite de alerta (REQ-28). O estorno continua pendente e sendo tentado.",
  "type": "object",
  "required": ["idEvento", "tipo", "versao", "ocorridoEm", "idCorrelacao", "dados"],
  "properties": {
    "idEvento": { "type": "string", "format": "uuid" },
    "tipo": { "const": "pagamento.estorno-atrasado" },
    "versao": { "const": 1 },
    "ocorridoEm": { "type": "string", "format": "date-time" },
    "idCorrelacao": { "type": "string", "format": "uuid" },
    "dados": {
      "type": "object",
      "required": ["estornoId", "pedidoId", "numero", "valor", "solicitadoEm", "tentativas", "atrasadoEm"],
      "properties": {
        "estornoId": { "type": "string", "format": "uuid" },
        "pedidoId": { "type": "string", "format": "uuid" },
        "numero": { "type": "string", "pattern": "^PED-\\d{8}-\\d{6}$" },
        "valor": { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.01 },
        "solicitadoEm": { "type": "string", "format": "date-time" },
        "tentativas": { "type": "integer", "minimum": 1 },
        "atrasadoEm": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
