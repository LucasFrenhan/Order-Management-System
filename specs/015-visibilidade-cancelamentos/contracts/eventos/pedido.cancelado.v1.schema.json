{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LucasFrenhan/Order-Management-System/specs/015-visibilidade-cancelamentos/contracts/eventos/pedido.cancelado.v1.schema.json",
  "title": "pedido.cancelado v1",
  "description": "Publicado em todo cancelamento de pedido, por qualquer caminho (REQ-15), na mesma gravação do cancelamento. Não é publicado para o pedido em PagamentoRejeitado.",
  "type": "object",
  "required": ["idEvento", "tipo", "versao", "ocorridoEm", "idCorrelacao", "dados"],
  "properties": {
    "idEvento": { "type": "string", "format": "uuid" },
    "tipo": { "const": "pedido.cancelado" },
    "versao": { "const": 1 },
    "ocorridoEm": { "type": "string", "format": "date-time" },
    "idCorrelacao": { "type": "string", "format": "uuid" },
    "dados": {
      "type": "object",
      "required": [
        "pedidoId", "numero", "motivo", "etapaEsgotada", "canceladoEm",
        "estoqueDevolvido", "estornoPendente", "ordemEntregaCancelada"
      ],
      "properties": {
        "pedidoId": { "type": "string", "format": "uuid" },
        "numero": { "type": "string", "pattern": "^PED-\\d{8}-\\d{6}$" },
        "motivo": { "enum": ["Cliente", "Operacao", "EstoqueInsuficiente", "ReconciliacaoEsgotada"] },
        "etapaEsgotada": { "enum": ["Estoque", "Pagamento", "Entrega", null] },
        "canceladoEm": { "type": "string", "format": "date-time" },
        "estoqueDevolvido": { "type": "boolean" },
        "estornoPendente": { "type": "boolean" },
        "ordemEntregaCancelada": { "type": "boolean" }
      },
      "if": { "properties": { "motivo": { "const": "ReconciliacaoEsgotada" } } },
      "then": { "properties": { "etapaEsgotada": { "type": "string" } } },
      "else": { "properties": { "etapaEsgotada": { "type": "null" } } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
