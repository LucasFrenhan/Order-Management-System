<Project>
  <!-- Pacotes justificados em specs/001-contratos-api/plan.md, specs/002-setup-infraestrutura/plan.md e specs/003-autenticacao-identity/plan.md (constituição: dependências exigem justificativa). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Correções de segurança transitivas">
    <!-- Microsoft.Data.SqlClient 7.1.1 traz a 9.0.18, vulnerável (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.2" />
    <!-- Só para a ferramenta de migrations (PrivateAssets=all). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Application">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Testes">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- Série 7.x: a partir da 8 a licença é comercial (research R-12). -->
    <PackageVersion Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Mesma versão maior do Microsoft.OpenApi usado por Microsoft.AspNetCore.OpenApi (2.x). -->
    <PackageVersion Include="Microsoft.OpenApi.YamlReader" Version="2.13.0" />
    <!-- 4.15.0, não 4.16.0: a 4.16.0 saiu há menos de duas semanas (specs/002-setup-infraestrutura/plan.md). -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.15.0" />
  </ItemGroup>
</Project>
