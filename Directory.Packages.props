<Project>
  <!-- Pacotes justificados em specs/001-contratos-api/plan.md (constituição: dependências exigem justificativa). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.2" />
  </ItemGroup>
  <ItemGroup Label="Testes">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <!-- Série 7.x: a partir da 8 a licença é comercial (research R-12). -->
    <PackageVersion Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Mesma versão maior do Microsoft.OpenApi usado por Microsoft.AspNetCore.OpenApi (2.x). -->
    <PackageVersion Include="Microsoft.OpenApi.YamlReader" Version="2.13.0" />
  </ItemGroup>
</Project>
