{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Migrations, perfis, usuários iniciais e catálogo são da API; o Worker só usa o banco.
  "Banco": {
    "PrepararNaInicializacao": false
  },
  // Padrões da mensageria (specs/006-mensageria, data-model); os intervalos de nova tentativa
  // padrão (1 s, 2 s e 4 s) valem quando Mensageria:IntervalosNovaTentativaMs não é configurado.
  "Mensageria": {
    "IntervaloDespachoMs": 1000,
    "TamanhoLote": 50,
    "PrefetchConsumidor": 10
  },
  // Gateway de pagamento por HTTP (specs/019-gateway-pagamento-http, contrato do cliente): UrlBase e
  // ChaveApi obrigatórias, do ambiente (GatewayPagamento__UrlBase e GatewayPagamento__ChaveApi); 3 s
  // por tentativa, até 3 tentativas com espera exponencial a partir de 300 ms, 10 s no total; o
  // circuito abre com 50% de falhas em 30 s (mínimo 6 chamadas) e pausa 30 s. Fora das faixas, o
  // Worker não sobe. A taxa de aprovação é da API simulada.
  "GatewayPagamento": {
    "TempoTentativaMs": 3000,
    "Tentativas": 3,
    "EsperaBaseMs": 300,
    "TempoTotalMs": 10000,
    "Circuito": {
      "ProporcaoFalhas": 0.5,
      "MinimoChamadas": 6,
      "JanelaSegundos": 30,
      "PausaSegundos": 30
    }
  },
  // Reconciliação de pedidos parados (specs/012-publicacao-garantida, research R-10): ciclo a
  // cada 5 min, parado há mais de 10 min, lote de 100; esgota estoque e pagamento depois de 24 h
  // e 3 ciclos com falha. Fora das faixas, o Worker não sobe.
  "Reconciliacao": {
    "Habilitada": true,
    "IntervaloCicloSegundos": 300,
    "LimiteParadoSegundos": 600,
    "LimiteEsgotamentoSegundos": 86400,
    "CiclosFalhaEsgotamento": 3,
    "TamanhoLote": 100
  },
  // Estornos pendentes (specs/013-cancelamento-com-estorno, research R-09): rodada a cada 1 min,
  // lote de 100; erro no log depois de 24 h e 3 tentativas com falha, sem desistir. Fora das
  // faixas, o Worker não sobe.
  "Estornos": {
    "Habilitado": true,
    "IntervaloSegundos": 60,
    "TamanhoLote": 100,
    "LimiteAlertaSegundos": 86400,
    "TentativasAlerta": 3
  },
  // Limpeza de mensageria e idempotência (specs/014-limpeza-e-dlq, research R-10): a cada 1 h,
  // em lotes; enviados e processados por 7 dias, chaves por 48 h (mínimo 24 h), pedidos de
  // reenvio por 90 dias. Fora das faixas, o Worker não sobe.
  "Limpeza": {
    "Habilitada": true,
    "IntervaloSegundos": 3600,
    "TamanhoLote": 1000,
    "LotesPorRodada": 10,
    "RetencaoEnviadosHoras": 168,
    "RetencaoProcessadosHoras": 168,
    "RetencaoChavesHoras": 48,
    "RetencaoPedidosReenvioHoras": 2160
  },
  // Telemetria (specs/016-observabilidade-opentelemetry): desligada sem OTEL_EXPORTER_OTLP_ENDPOINT
  // (destino OTLP); amostragem de todos os traces e leitura do outbox para as métricas a cada 30 s.
  // Fora das faixas, o Worker não sobe.
  "Observabilidade": {
    "TaxaAmostragem": 1.0,
    "IntervaloAmostragemOutboxSegundos": 30
  },
  // Reenvio da DLQ pedido pelo Admin e aviso de tamanho (specs/014-limpeza-e-dlq): pedidos
  // executados a cada 1 min, até 3 reenvios por mensagem; aviso acima de 10 mensagens, no máximo a
  // cada 5 min; com a telemetria ligada, a DLQ é lida a cada 1 min para a métrica (REQ-16).
  "ReenvioDlq": {
    "Habilitado": true,
    "IntervaloSegundos": 60,
    "MaximoReenvios": 3,
    "MensagensPorPedido": 1000,
    "AvisoHabilitado": true,
    "AvisoLimite": 10,
    "AvisoIntervaloSegundos": 300,
    "MetricaIntervaloSegundos": 60
  }
}
