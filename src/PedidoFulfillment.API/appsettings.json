{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Telemetria (specs/016-observabilidade-opentelemetry): desligada sem OTEL_EXPORTER_OTLP_ENDPOINT
  // (destino OTLP); amostragem de todos os traces. Fora da faixa, a API não sobe.
  "Observabilidade": {
    "TaxaAmostragem": 1.0
  },
  // Limite de requisições (specs/023-rate-limiting): com balanceador, informe os endereços dele em
  // IntermediariosConfiaveis, ou todos os clientes dividem uma só contagem. A ChaveContagem, obrigatória
  // e igual em todas as instâncias, vem do ambiente (LimiteRequisicoes__ChaveContagem).
  "LimiteRequisicoes": {
    "LoginOrigemEmail": { "Limite": 10, "JanelaSegundos": 60 },
    "LoginOrigem": { "Limite": 100, "JanelaSegundos": 60 },
    "Registro": { "Limite": 20, "JanelaSegundos": 3600 },
    // Ciclo da autenticação (specs/024-ciclo-autenticacao).
    "RecuperacaoOrigemEmail": { "Limite": 3, "JanelaSegundos": 3600 },
    "RecuperacaoOrigem": { "Limite": 20, "JanelaSegundos": 3600 },
    "ReenvioOrigemEmail": { "Limite": 3, "JanelaSegundos": 3600 },
    "ReenvioOrigem": { "Limite": 20, "JanelaSegundos": 3600 },
    "Redefinicao": { "Limite": 10, "JanelaSegundos": 60 },
    "Confirmacao": { "Limite": 10, "JanelaSegundos": 60 },
    "Renovacao": { "Limite": 120, "JanelaSegundos": 60 },
    "Logout": { "Limite": 120, "JanelaSegundos": 60 },
    "TempoMaximoEsperaMs": 250,
    "PausaAposFalhaSegundos": 5,
    "IntermediariosConfiaveis": []
  },
  // Sessões renováveis (specs/024-ciclo-autenticacao, FR-005).
  "Sessoes": {
    "ValidadeTokenRenovacaoDias": 14,
    "DuracaoMaximaDias": 30
  },
  "Jwt": {
    "Emissor": "PedidoFulfillment",
    "Audiencia": "PedidoFulfillment",
    "DuracaoTokenMinutos": 15
  }
}
