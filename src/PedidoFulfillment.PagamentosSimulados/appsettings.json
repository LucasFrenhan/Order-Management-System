{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  // Chaves de acesso (specs/019-gateway-pagamento-http, research R-05): obrigatórias, com 16+
  // caracteres e diferentes entre si; sem elas a API não sobe. Vêm do ambiente (Seguranca__ChaveApi
  // e Seguranca__ChaveControle); valores de desenvolvimento só no appsettings.Development.json.
  "Seguranca": {
    "ChaveApi": "",
    "ChaveControle": ""
  },
  // Comportamento simulado (contrato da API › Configuração): latência de 40 a 250 ms, com 5% entre
  // 1 e 5 s; 90% de aprovação entre as que efetivam; poucas falhas de cada tipo. Fora das faixas,
  // a API não sobe. A rota de controle muda estes valores com a API no ar.
  "Simulacao": {
    "Deterministico": false,
    "LatenciaMinimaMs": 40,
    "LatenciaMaximaMs": 250,
    "CaudaPercentual": 5,
    "CaudaMinimoMs": 1000,
    "CaudaMaximoMs": 5000,
    "TaxaAprovacaoPercentual": 90,
    "IndisponivelPercentual": 2,
    "LimiteTaxaPercentual": 1,
    "RetryAfterSegundos": 1,
    "ErroInternoPercentual": 1,
    "SemRespostaPercentual": 1,
    "ProcessarSemResponderPercentual": 1,
    "SemRespostaMs": 15000
  }
}
