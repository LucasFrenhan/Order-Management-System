# Variáveis do docker-compose.yml. Copie para .env (ignorado pelo Git) e ajuste.
# Valores SOMENTE DE DESENVOLVIMENTO; os padrões abaixo são os mesmos do compose.
# Ao trocar porta ou credencial, sobrescreva também a configuração da API ao rodá-la:
#   ConnectionStrings__SqlServer, RabbitMQ__Porta, RabbitMQ__Usuario, RabbitMQ__Senha

# Porta local do SQL Server
OMS_SQL_PORTA=1433
# Senha do usuário sa: 8+ caracteres com maiúscula, minúscula, dígito e símbolo
OMS_SQL_SENHA=OmsDev_2026!Local
# Porta AMQP local do RabbitMQ
OMS_RABBITMQ_PORTA=5672
# Porta local do painel de administração do RabbitMQ
OMS_RABBITMQ_PORTA_PAINEL=15672
# Usuário do RabbitMQ usado pelo Worker (publica e consome)
OMS_RABBITMQ_USUARIO=oms
# Senha do RabbitMQ do Worker
OMS_RABBITMQ_SENHA=oms-dev-local
# Usuário do RabbitMQ usado pela API: só conecta para a prontidão, sem permissões (REQ-14)
OMS_RABBITMQ_API_USUARIO=oms-api
# Senha do usuário da API no RabbitMQ
OMS_RABBITMQ_API_SENHA=oms-api-dev-local
# Porta local da API no perfil demo (docker compose --profile demo up -d --wait --build)
OMS_API_PORTA=5230
# Porta local do Worker no perfil demo (só /health e /health/pronto)
OMS_WORKER_PORTA=5231

# Senhas com "$" precisam ser escritas como "$$", senão o Docker Compose as interpola.
