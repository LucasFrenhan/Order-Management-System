<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PedidoFulfillment.API\PedidoFulfillment.API.csproj" />
    <ProjectReference Include="..\..\src\PedidoFulfillment.Worker\PedidoFulfillment.Worker.csproj" />
    <!-- API de pagamento simulada, servida em Kestrel pelos testes do REQ-19 (research R-13). -->
    <ProjectReference Include="..\..\src\PedidoFulfillment.PagamentosSimulados\PedidoFulfillment.PagamentosSimulados.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 6 testes em paralelo, fixo em qualquer máquina (1,5 por vCPU no runner do CI): os testes
         passam a maior parte do tempo esperando I/O; com 8, testes com prazo de espera às vezes
         estouram (issue #70, docs/otimizacao-ci.md). -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\specs\001-contratos-api\contracts\openapi-v1.yaml" Link="Contrato\openapi-v1.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Schemas dos eventos (REQ-06, REQ-08, REQ-10, REQ-15, REQ-18 e REQ-28), para os testes de conformidade. -->
    <None Include="..\..\specs\006-mensageria\contracts\eventos\*.schema.json" LinkBase="Eventos" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\specs\008-estoque\contracts\eventos\*.schema.json" LinkBase="Eventos" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\specs\010-fulfillment\contracts\eventos\*.schema.json" LinkBase="Eventos" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\specs\015-visibilidade-cancelamentos\contracts\eventos\*.schema.json" LinkBase="Eventos" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\specs\018-notificacao-status\contracts\eventos\*.schema.json" LinkBase="Eventos" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\specs\028-acoes-estornos-pendentes\contracts\eventos\*.schema.json" LinkBase="Eventos" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\specs\018-notificacao-status\contracts\notificacoes\*.schema.json" LinkBase="Notificacoes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
